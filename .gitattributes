# Normalización de fin de línea: los scripts y la unidad systemd DEBEN
# quedar en LF en el repositorio (CRLF rompe bash y systemd en Linux).
* text=auto
*.sh text eol=lf
*.service text eol=lf
*.desktop text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.ps1 text eol=crlf
